        upstream_auth_kind: host-key
      codex_responses_lite:
        version: codex-cli 0.150.1
        model: gpt-5.6-luna
        multi_agent_disabled: false
        exit_code: 0
        agent_message: E2E_OK
        usage_input_tokens: 5
        usage_output_tokens: 2
