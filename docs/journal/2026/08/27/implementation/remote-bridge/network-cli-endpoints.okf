      generic_high_demand_message: false
      exact_tool_search_reason_reached_codex: true
    actual_with_multi_agent_false:
      exit_code: 0
      agent_message: E2E_OK
      caveat: other deferred tool sources can still add tool_search

  final_protocol_audit:
    status: passed
    remaining_blockers: 0
    verified_boundaries:
      - exact official Codex 0.150.1 custom-tool grammar allowlist
      - LF/CRLF definition normalization and bare-CR rejection
      - apply_patch base and optional Environment-ID payload validation
      - code-mode exec payload validation
      - namespace and toolset spoof rejection
      - Responses and Anthropic bidirectional exact tool identity
      - OpenAI Chat schema and message-name loss rejection
    focused_regression:
      anthropic_responses_bridge: 60 passed
      openai_chat_compatibility_bridge: 22 passed
      codex_runtime: 69 run, 12 skipped, 0 failed
      ruff: passed
