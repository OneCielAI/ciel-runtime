      claude_code:
        version: 2.1.247
        model: vllm/e2e-model
        exit_code: 0
        result: E2E_OK
        stop_reason: end_turn
        usage_input_tokens: 5
        usage_output_tokens: 2
        upstream_effort: high
        upstream_auth_kind: host-key
    copilot_router_host_credential:
      live_oauth_status: connected
      live_oauth_account: OneCielAI
      live_token_expiry: 2026-08-28 02:14:45 Central Daylight Time
      live_upstream_model_count: 57
      remote_client_supplied_oauth: false
      oauth_token_value_printed: false
    copilot_public_catalog_live_projection:
      upstream_models: 57
      public_models: 29
      kimi_k3_present: true
      mai_code_1_flash_present: true
      internal_picker_secondary_4th_name_matches: 0
      mai_upstream_wire_id: mai-code-1-flash-picker
    upstream_privacy_capture:
      total_records: 44
      host_key_records: 41
      request_key_records: 3
      bridge_token_records: 0
      bridge_control_header_records: 0
      observed_models:
        - e2e-model
        - gpt-5.5
        - gpt-5.6-luna
      observed_efforts:
        - high
        - low
        - medium
    retained_execution_artifacts:
      location: .tmp/remote-bridge-e2e
      tracked_by_git: false
      contains_real_token_values_in_journal: false

  verification:
    stage: complete
    targeted_bridge:
      bridge_pattern: 345 run, 80 skipped, 0 failed
      responses_anthropic_stream: 21 run, 0 failed
      openai_responses_stream: 6 run, 0 failed
      combined: 372 run, 80 skipped, 0 failed
      remote_bridge_http: 10 run, 0 failed
    architecture:
      budget: 2 run, 0 failed
      contracts: 261 run, 42 skipped, 0 failed
    static:
      python_compileall: 349 Python files passed
      ruff: 0.15.22 passed
      documentation_metadata: 24 Markdown files passed
      diff_check: passed
    final_post_change_full_suite:
      unit: 1318 run, 44 skipped, 0 failed
      router: 1054 run, 0 failed
      channel: 385 run, 80 skipped, 0 failed
      runtime: 258 run, 12 skipped, 0 failed
      total: 3015 run, 136 skipped, 0 failed, 0 errors
      status: passed

  security:
    real_credentials_committed: false
    bridge_token_committed: false
    exact_live_oauth_values_added_to_diff: 0
    exact_bridge_token_values_added_to_diff: 0
    exact_runtime_api_key_values_added_to_diff: 0
    generic_secret_pattern_added_line_matches: 0
    router_host_copilot_oauth_file_modified: false
    test_credentials: isolated fake host and request keys
    ignored_execution_logs_retained: true
    verification_ports_listening_after_cleanup: 0
    status_endpoint_exposes_secret_values: false
    plaintext_http_limitation_documented: true
    independent_read_only_audit:
      relevant_tests: 114 passed
      blocker_high_medium_low_findings: 0
    loopback_proxy_boundary:
      router_trusts_direct_loopback_peer: true
      on_host_tls_proxy_must_validate_bridge_token: true
      router_plaintext_port_must_not_be_externally_reachable: true

  codex_0150_freeform_apply_patch:
    status: targeted_verified
    official_source:
      version: codex-cli 0.150.1
      tool_spec: >-
        https://github.com/openai/codex/blob/rust-v0.150.1/codex-rs/core/src/tools/handlers/apply_patch_spec.rs
      grammar: >-
        https://raw.githubusercontent.com/openai/codex/refs/tags/rust-v0.150.1/codex-rs/core/src/tools/handlers/apply_patch.lark
    observed_pre_fix_failure: >-
      Responses custom tool grammar cannot be projected to Anthropic
    projection:
      supported_format:
        type: grammar
        syntax: lark
        definition: >-
          exact official Codex 0.150.1 apply_patch.lark base text or the
          apply_patch_spec.rs optional-Environment-ID replacement
      anthropic_wire: >-
        The exact JSON-encoded Responses format contract is included in the
        standard Anthropic tool description, and input_schema requires exactly
        one string field named input for the complete raw payload.
      unsupported_formats: fail_closed
      other_lark_definitions: fail_closed
      malformed_return_envelope: fail_closed
      returned_patch_grammar_validation: required
      environment_id_position_and_cardinality_validation: required
      restored_item_type: custom_tool_call
      raw_input_roundtrip: exact
    regression:
      anthropic_responses_bridge: 60 passed
      codex_runtime: 69 passed, 12 skipped
      openai_responses_stream: 6 passed
      python_compile: passed
      diff_check: passed
    actual_codex_gpt_5_5_e2e:
      status: passed
      model: vllm/gpt-5.5
      required_isolated_config: features.multi_agent=false
      exit_code: 0
      agent_message: E2E_OK
      upstream_effort: low
    secrets_printed: false

  codex_0150_code_mode_exec:
    status: actual_client_verified
    official_source: >-
      https://github.com/openai/codex/blob/rust-v0.150.1/codex-rs/core/src/tools/code_mode/execute_spec.rs
    actual_client_capture:
      model: gpt-5.6-luna
      placement: Responses Lite additional_tools namespace functions member exec
      grammar_normalized_length: 177
      grammar_normalized_sha256: 8eead048e20069c17fcd0b6fe5ee9ed29364868723f8e08889de146a2b4b7a8e
      exact_official_literal_match: true
    projection:
      allowed_definition: exact official Codex 0.150.1 code-mode exec grammar
      other_lark_definitions: fail_closed
      returned_input_validation: non-empty SOURCE required
      restored_item_type: custom_tool_call
      namespace_restored: functions
      member_name_restored: exec
    actual_codex_e2e:
      exit_code: 0
      agent_message: E2E_OK
      usage_input_tokens: 5
      usage_output_tokens: 2
      upstream_effort: low

  codex_0150_responses_lite:
    status: actual_client_verified
    accepted_fields:
      reasoning_context: all_turns
      leading_input_item: additional_tools
      reasoning_summary_delivery: sequential_cutoff
      internal_metadata:
        - turn_id
        - create_time
        - content_item_kinds
    fail_closed:
      - duplicate or misplaced additional_tools
      - conflicting top-level tools
      - unsupported reasoning context
      - unsupported summary delivery mode
      - unknown or invalid internal metadata
    actual_client:
      model: gpt-5.6-luna
      exit_code: 0
      agent_message: E2E_OK
      usage_input_tokens: 5
      usage_output_tokens: 2
      upstream_effort: low

  codex_0150_tool_search_boundary:
    status: verified
    official_source:
      model_catalog: >-
        https://github.com/openai/codex/blob/rust-v0.150.1/codex-rs/models-manager/models.json
      search_gate: >-
        https://github.com/openai/codex/blob/rust-v0.150.1/codex-rs/core/src/tools/spec_plan.rs
