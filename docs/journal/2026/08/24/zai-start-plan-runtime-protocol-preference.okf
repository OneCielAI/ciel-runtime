      codex_endpoint: https://zcode.z.ai/api/v1/zcode-plan/chat/completions
      claude_protocol: anthropic_messages
      claude_endpoint: https://zcode.z.ai/api/v1/zcode-plan/anthropic/v1/messages
    full_regression:
