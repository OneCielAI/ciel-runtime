okf:
  version: "1.0"
  kind: engineering-journal
  task:
    id: zai-plan-endpoint-separation-20260825
    title: Z.AI Start Plan and Coding Plan endpoint separation
    status: in_progress
    objective: >-
      Reconstruct and verify the Start Plan authentication, endpoint, request
      headers, CAPTCHA lifecycle, and Ciel router integration from installed
      official ZCode artifacts rather than general provider assumptions.

  evidence:
    official_zcode_desktop:
      host: mia@100.95.132.58
      application: /home/mia/Applications/ZCode-3.9.1-extracted/squashfs-root/zcode
      version: 3.9.1
      app_archive: /home/mia/Applications/ZCode-3.9.1-extracted/squashfs-root/resources/app.asar
      runtime_bundle: /home/mia/Applications/ZCode-3.9.1-extracted/squashfs-root/resources/glm/zcode.cjs
      runtime_sha256: 883c12ab99b790fadc5f3ec2f229acd269d8c5460654b4c279c1e18368c436d8
    installed_profile:
      source: /home/mia/.zcode/v2/config.json
      selection_source: /home/mia/.zcode/v2/setting.json
      selected_key: coding-plan:builtin:zai-start-plan
      mode: oauth
      provider_kind: anthropic
      start_plan_base_url: https://zcode.z.ai/api/v1/zcode-plan/anthropic
      coding_plan_base_url: https://api.z.ai/api/anthropic
      credential_observation:
        start_plan: desktop JWT, length 231, sha256_prefix fa47127c9e52
        coding_plan: CLI API key, length 49, sha256_prefix d606cf0e506e
        conclusion: credentials are distinct and are not interchangeable
    installed_bundle_routes:
      start_plan_anthropic: /api/v1/zcode-plan/anthropic/v1/messages
      start_plan_openai_chat: /api/v1/zcode-plan/chat/completions
      off_peak_anthropic: /api/v1/off-peak/anthropic/v1/messages
    installed_bundle_captcha:
      config_endpoint: https://zcode.z.ai/api/v1/client/configs
      sdk: https://o.alicdn.com/captcha-frontend/aliyunCaptcha/AliyunCaptcha.js
      result_header: X-Aliyun-Captcha-Verify-Param
      region_header: X-Aliyun-Captcha-Verify-Region
      observed_region: sgp
    signature_feature_probe:
      agent_config_status: 200
      client_config_status: 200
      codingPlanSignature_present: false
      conclusion: >-
        The installed runtime's signing feature gate is currently disabled by
        server configuration. No signing implementation was inferred or added.
    official_cli_oauth_0165:
      source_contract:
        init: POST https://zcode.z.ai/api/v1/oauth/cli/init
        poll: GET https://zcode.z.ai/api/v1/oauth/cli/poll/{flow_id}
        callback_owner: Z.AI server
      captured_2026_08_25:
        init_http_status: 200
        init_business_code: 0
        poll_transition: pending -> ready
        credential_written: true
        fresh_start_plan_jwt_sha256_prefix: 6ea3ad9709f1
      correction: >-
        The failed browser callback screenshot did not prove a Ciel state
        mismatch. A new flow executed by the installed official runtime reached
        ready and wrote a different JWT.
    fresh_credential_control:
      jwt_claim_keys: [iat, sub, user_id]
      exp_claim_present: false
      billing_current:
        http_status: 405
        provider_code: 3012
        message: method not allowed
      billing_balance:
        http_status: 405
        provider_code: 3012
        message: method not allowed
      conclusion: >-
        Refreshing the official OAuth credential did not clear the provider
        rejection on the official Start Plan billing routes. Token expiry is
        not established as the cause.
    official_runtime_model_control:
      old_credential_result:
        endpoint: https://zcode.z.ai/api/v1/zcode-plan/anthropic/v1/messages
        method: POST
        captcha_headers_present: true
        authorization_headers_present: true
        model: GLM-5.3
        http_status: 405
        provider_code: 3012
      fresh_credential_result: captcha_timeout_without_operator_submission

  contradiction_correction:
    previous_claim: >-
      Start Plan had no verified route and Mia's provider rejection represented
      unavailable quota.
    conflicting_evidence: >-
      Official ZCode Desktop 3.9.1 exposes a separate Start Plan provider,
      endpoint, JWT, full Start Plan model balances, and request-time CAPTCHA
      interaction logs. The earlier request used the Coding Plan endpoint.
    corrected_fact: >-
      Start Plan and Coding Plan are separate contracts. A Coding Plan quota
      rejection does not describe Start Plan quota.

  implementation:
    provider_adapter:
      start_plan_final_url: https://zcode.z.ai/api/v1/zcode-plan/anthropic/v1/messages
      protocol: anthropic_messages
      coding_plan_inheritance_removed_for_anthropic_base: true
      zcode_source_headers_added: true
    credentials:
      coding_plan_source: ~/.zcode/cli/config.json
      start_plan_source: ~/.zcode/v2/config.json plus ~/.zcode/v2/setting.json
      profile_isolation: true
    captcha:
      request_scoped: true
      state_bound_receiver: true
      fresh_per_upstream_attempt: true
      result_persisted: false
    oauth_shared_credential:
      official_store: ~/.zcode/v2/credentials.json
      key: zcodejwttoken
      cipher: AES-256-GCM
      serialized_prefix: "enc:v1:"
      iv_bytes: 12
      authentication_tag_bytes: 16
      secret_derivation: >-
        SHA-256 of ZCODE_CREDENTIAL_SECRET when set, otherwise the exact
        official platform/home/username fallback string
      plaintext_logged: false
      desktop_config_fallback_retained: true

  verification:
    targeted:
      zai_provider: 8 passed
      zai_oauth: 8 passed
      zai_start_plan_captcha: 4 passed
      runtime_interaction: 5 passed
      provider_launch_endpoint: 8 passed
      provider_contract_matrix: 41 passed
      architecture_budget: 2 passed
      zcode_runtime: 9 passed
    full_suite:
      unit: 1187 passed, 44 skipped
      router: 931 passed
      channel: 382 passed, 80 skipped
      runtime: 255 passed, 12 skipped
      total: 2755 passed, 136 skipped
    mia_local_deployment:
      official_oauth_poll_result: ready
      shared_reader_result:
        present: true
        length: 231
        sha256_prefix: 6ea3ad9709f1
        claim_keys: [iat, sub, user_id]
      ciel_import_result:
        provider: zai-start-plan
        credential_source: zai-oauth
        sha256_prefix: 6ea3ad9709f1
      isolated_router:
        port: 8898
        pid: 2860163
        workspace: /tmp/ciel-start-plan-e2e-600e230/workspace
        user_session_router_8800_modified: false
        live_request_status: captcha_completed_upstream_rejected
        runtime_interaction_status: completed
        upstream_http_status: 405
        upstream_provider_code: 3012
        upstream_message: Your account has been flagged for unusual activity.
        conclusion: >-
          The refreshed official JWT, state-bound CAPTCHA, router request, and
          upstream response path all completed. Z.AI rejected the account after
          verification; this response is not a quota-exhaustion or Ciel
          callback-state error.
    distribution:
      commit: 600e23041cdc32f14c504133c6c337a8a745df1d
      nightly: 0.2.36-nightly.20260825-064641.600e230
      origin_nightly_pushed: true
      local_installed: true
      mia_installed: true
    shared_oauth_fix_distribution:
      commit: 11afdb5c31c5cc98f04bf755a1fc218f588c2843
      nightly: 0.2.36-nightly.20260825-085507.11afdb5
      ci: success
      npm_publish: success
      published_tarball_verification: success
      local_registry_artifact_installed: true
      mia_registry_artifact_installed: true
    browser_render:
      url_scope: loopback state-bound test receiver
      sdk_loaded: official Aliyun CAPTCHA SDK
      observed_terminal_text: Verification complete. Returning to Ciel Runtime…
      local_receiver_result_accepted: true
      screenshot_captured: true
    pending:
      - official ZCode 0.16.5 model response with the freshly issued JWT
      - Z.AI account-side unusual-activity restriction resolution and live retry
