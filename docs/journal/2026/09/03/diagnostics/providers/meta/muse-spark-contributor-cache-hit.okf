  codex_wire_probe:
    method: Codex 0.152.1 was connected to an isolated loopback HTTP capture server.
    requests: 3
    confirmed:
      prompt_cache_key_present: true
      prompt_cache_key_stable_across_requests: true
      prompt_cache_retention_present: false
